# Application Settings
APP_NAME="Sweet Cookie Oven"
APP_ENV=development
APP_DEBUG=true

# Choose Active Database: "supabase" or "mysql"
DB_CONNECTION=supabase

# ========================================================
# Option 1: Supabase PostgreSQL Connection (RECOMMENDED)
# ========================================================
# Get these in Supabase Dashboard -> Project Settings -> Database:
# Host is under "Connection info" -> Host (e.g., db.abcdefghijklmno.supabase.co)
# Port is 5432 (or 6543 for Transaction Pooler)
# Database name is always 'postgres'
# User is 'postgres'
# Password is the database password you chose when creating the Supabase project
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Supabase REST / API Keys (Optional, if using REST endpoints)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ========================================================
# Option 2: Local MySQL (XAMPP Backup)
# ========================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sweet_cookie_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=
